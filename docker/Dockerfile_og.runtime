FROM node:lts

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      lftp \
      rsync \
      ca-certificates \
      sshpass \
 && rm -rf /var/lib/apt/lists/*

# Adjust this if your host's docker group GID is different
ARG DOCKER_GID=995

# Ensure a 'docker' group exists with the correct GID
# If 'docker' exists already, normalize its GID; otherwise create it.
RUN set -eux; \
    if getent group docker >/dev/null; then \
      groupmod -g "${DOCKER_GID}" docker; \
    else \
      groupadd -g "${DOCKER_GID}" docker; \
    fi

# Bake users with fixed UIDs and primary group = docker
# 999 == svc-dev on host, 1003 == mattteixeira on host
RUN useradd -m -u 999  -g docker -s /bin/bash svcDev || true \
 && useradd -m -u 1003 -g docker -s /bin/bash hostUser || true


# Set a cooperative umask for all shells
# - /etc/profile.d: login shells
# - /etc/bash.bashrc: interactive non-login shells
# - BASH_ENV: non-interactive shells (e.g., `bash -lc`, `bash -c`)
RUN printf 'umask ${UMASK:-0002}\n' > /etc/profile.d/umask.sh \
 && chmod 644 /etc/profile.d/umask.sh \
 && printf '\n# cooperative umask for all users\numask ${UMASK:-0002}\n' >> /etc/bash.bashrc

# Ensure non-interactive bash picks it up
ENV BASH_ENV=/etc/profile.d/umask.sh

# (optional) default UMASK value; can be overridden via compose env
ENV UMASK=0002

WORKDIR /workspace
ENV NPM_CONFIG_CACHE=/tmp/.npm
# (No USER here; choose at runtime via compose: user: appA|appB)

# CREATE IMAGE
# docker compose build app_tools
# Smaller and predictable base -> node:22-bookworm-slim; change to node:lts if you prefer floating tag
FROM node:lts

# Install CLI tools once (image build), then clean
RUN apt-get update \
 && apt-get install -y --no-install-recommends lftp rsync ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# --- Build-time host IDs (override at build) ---
ARG APP_UID=1000
ARG APP_GID=1000

# Create (or rename) a group called "docker" with GID=$APP_GID.
# Create a user "app" with UID=$APP_UID and primary group=that GID.
RUN set -eux; \
    if ! getent group "${APP_GID}" >/dev/null; then \
      groupadd -g "${APP_GID}" docker; \
    else \
      gname="$(getent group "${APP_GID}" | cut -d: -f1)"; \
      if [ "${gname}" != "docker" ]; then groupmod -n docker "${gname}"; fi; \
    fi; \
    if ! id -u app >/dev/null 2>&1; then \
      useradd -m -u "${APP_UID}" -g "${APP_GID}" app; \
    else \
      usermod -u "${APP_UID}" -g "${APP_GID}" app; \
    fi

# Working directory used by compose (matches your bind mount)
WORKDIR /workspace

# Optional: default HOME for the non-root user (keeps npm happy)
ENV HOME=/home/app

# Drop privileges permanently
USER app:docker

APP_NAME=data_acquisition

# Console verbosity of both loggers. Dev = log_and_console; release = file/db only.
LOGGER_MODE=log_and_console
#RELEASE:LOGGER_MODE=log

PHILIPS_MRI_SHELL_TIMEOUT_S=280

### START: DOCKER ENV SET UP ###

# ---------------------------------------------------------------------------
# RELEASE OVERRIDE CONVENTION
# Lines prefixed `#RELEASE:KEY=VALUE` are applied by build-release.sh to the
# COPIED .env in /opt/apps/data_acquisition: the active KEY= line is replaced
# and the markers stripped. The dev tree keeps both lines as one source of
# truth. Only IDENTITY belongs here (USER_ID, LOG_DIR, LOGGER_MODE);
# environment properties (PG*, REDIS_*) get NO override — they describe the
# server, not the release.
# ---------------------------------------------------------------------------

# USER_ID does triple duty: image tag (data-acqu:${USER_ID}), run-log file tag,
# and boot-log label. Dev = your host username; release = svc.
USER_ID=         # REQUIRED: your host username, e.g. matt-teixeira
#RELEASE:USER_ID=svc

# CONTAINER RUN USER: do NOT pin here. entrypoint.sh defaults to svc (one place
# decides the production identity); dev runs pass it on the command line:
#   RUN_USER=<you> docker compose run --rm app_tools node index.js <args>

## VOLUME OPTIONS

# RUN LOGS: host directory mounted over /workspace/utils/logger/logs. The code
# always writes the container path; THIS variable decides where that lands on
# the host. Missing value defaults to the dev path (fails safe).
LOG_DIR=./utils/logger/logs
#RELEASE:LOG_DIR=/opt/run-logs/data_acquisition

# (NODE_MOD_CACHE_DEV retired 2026-08 — node_modules is in-tree per copy,
#  installed by build.sh; each copy owns its own deps.)

# SSH KEY (used by rsync_mmb.sh via /opt/resources/ssh/)
SSH_KEY=

# DATA STORE PATHS
DATA_STORE_DEV=/opt/resources/acqu_files
#DATA_STORE_DEV=



### END: DOCKER ENV SET UP ###

# PROD AZURE DB
# PG_PORT=
# PG_USER=
# PG_PW=
# PG_DB=
# PG_HOST=
# PG_SSL_PATH=

# STAGING DOCKER DB
# PGHOST=
PGHOST=pg_db
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=      # REQUIRED: <DB_NAME> per the setup doc identity table (dev / staging / prod)
PG_SSLMODE=require
PG_SSL_PATH=/opt/resources/ssl/pg_ssl.crt


# ENCRYPTION KEY
APP_SECRET=

# prod
VNS3_IP=
VNS3_PW=

# REDIS_IP=
REDIS_HOST=redis_dev-0-4
REDIS_PORT=6379
# Auth for redis_dev-0-4 (REDIS-01, 2026-08-18): set from the root-only secret
# /opt/resources/secrets/redis_auth.conf — activate_redis_auth.sh propagates it.
# Leave empty ONLY if the target instance has no requirepass (a password here
# against a passwordless server makes node-redis hang in a reconnect loop).
REDIS_PW=

# BUILD ARGS for Dockerfile_2 (util-hybride-ep)
DOCKER_GID=      # REQUIRED: getent group docker | cut -d: -f3  (host identity is per-server — REL-07)
UID_0=           # REQUIRED: id -u svc
UID_1=           # REQUIRED: id -u <admin user 1>
UID_2=           # REQUIRED: id -u <admin user 2>

#### START ####
# FOR SCHEMA/TABLE MIGRATIONS
# ---- Source (Azure) ----
SRC_HOST=
SRC_PORT=5432
SRC_DB=          # migration source db (per migration task)
SRC_USER=
SRC_PASSWORD=
SRC_SSLMODE=verify-full
SRC_SSLROOTCERT=system

## PROD
# SRC_PORT=
# SRC_USER=
# SRC_PASSWORD=
# SRC_DB=
# SRC_HOST=
# SRC_SSLMODE=
# SRC_SSLROOTCERT=

# ---- Destination (local Docker) ----
DST_HOST=host.docker.internal
DST_PORT=5432
DST_DB=          # migration destination db (<DB_NAME> of this server)
DST_USER=
DST_PASSWORD=
DST_SSLMODE=disable
#### END ####


### NOTES ###

## Local psql
# psql -h localhost -p 5432 -U postgres -d postgres
# pw: <in secret store — never commit real values>

## REDIS ACCESS
# docker exec -it redis-PROD redis-cli
# docker exec -it redis-STAGING redis-cli
# docker exec -it redis_dev-0-4 redis-cli
# docker exec -it redis_dev-0-5 redis-cli
## ---- host identity (differs per host; never hardcode in tracked files) ----
## staging: DOCKER_GID=987 UID_0=105 | dev: DOCKER_GID=990 UID_0=104
## (IMAGE_TAG retired 2026-08 — the image tag is now data-acqu:${USER_ID})

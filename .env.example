APP_NAME=
LOGGER=dev
RUN_ENV=dev
PHILIPS_MRI_SHELL_TIMEOUT_S=280

### START: DOCKER ENV SET UP ###

# CONTAINER RUN USER (default svc)
RUN_USER=svc
#RUN_USER=
#RUN_USER=

## VOLUME OPTIONS

# RUN LOGS: go here during non-dev runs. Path controlled at utils/logger/log.js through .env RUN_ENV
RUN_LOGS_DIR=/opt/run-logs/data_acquisition:/opt/run-logs/data_acquisition

# NODE MODULES CACHE
NODE_MOD_CACHE_DEV=/opt/resources/node_mod_cache/data_acquisition

# SSH KEY (used by rsync_mmb.sh via /opt/resources/ssh/)
SSH_KEY=

# DATA STORE PATHS
DATA_STORE_DEV=/opt/resources/acqu_files
#DATA_STORE_DEV=



### END: DOCKER ENV SET UP ###

# PROD AZURE DB
# PG_PORT=
# PG_USER=
# PG_PW=
# PG_DB=
# PG_HOST=
# PG_SSL_PATH=

# STAGING DOCKER DB
# PGHOST=
PGHOST=pg_db
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=staging
PG_SSLMODE=require
PG_SSL_PATH=/opt/resources/ssl/pg_ssl.crt


# ENCRYPTION KEY
APP_SECRET=

# prod
VNS3_IP=
VNS3_PW=

# REDIS_IP=
REDIS_HOST=redis_dev-0-4
REDIS_PORT=6379

# BUILD ARGS for Dockerfile_2 (util-hybride-ep)
DOCKER_GID=987
UID_0=105
UID_1=1001
UID_2=1006

#### START ####
# FOR SCHEMA/TABLE MIGRATIONS
# ---- Source (Azure) ----
SRC_HOST=
SRC_PORT=5432
SRC_DB=staging
SRC_USER=
SRC_PASSWORD=
SRC_SSLMODE=verify-full
SRC_SSLROOTCERT=system

## PROD
# SRC_PORT=
# SRC_USER=
# SRC_PASSWORD=
# SRC_DB=
# SRC_HOST=
# SRC_SSLMODE=
# SRC_SSLROOTCERT=

# ---- Destination (local Docker) ----
DST_HOST=host.docker.internal
DST_PORT=5432
DST_DB=dev
DST_USER=
DST_PASSWORD=
DST_SSLMODE=disable
#### END ####


### NOTES ###

## Local psql
# psql -h localhost -p 5432 -U postgres -d postgres
# pw: <in secret store — never commit real values>

## REDIS ACCESS
# docker exec -it redis-PROD redis-cli
# docker exec -it redis-STAGING redis-cli
# docker exec -it redis_dev-0-4 redis-cli
# docker exec -it redis_dev-0-5 redis-cli
## ---- host identity (differs per host; never hardcode in tracked files) ----
## staging: DOCKER_GID=987 UID_0=105 | dev: DOCKER_GID=990 UID_0=104
IMAGE_TAG=staging
